DEF HMIS_ROBOT Moose {
  translation 0.0 0.0 0.450
  name "K-11"
  controller "hmis"
  color 0.9 0.55 0.1
  bodySlot [
    Receiver { name "receiver" channel 1 }
    Emitter { name "emitter" channel 2 }
    Pose { translation 0.85 0 0.42 children [ LED { name "beacon" color [ 0.1 0.95 0.2, 1 0.65 0 ] children [ Shape { appearance PBRAppearance { baseColor 0.25 0.25 0.25 roughness 0.3 metalness 0 } geometry Cylinder { height 0.14 radius 0.08 } } ] } ] }
  ]
}
DEF OPERATOR Pedestrian {
  translation 6.0 4.0 1.293
  rotation 0 0 1 -2.5536
  name "operator"
  controller "operator_figure"
  controllerArgs [ "--animated" ]
  shirtColor 0.95 0.45 0.05
  pantsColor 0.15 0.18 0.25
  bodySlot [ Receiver { name "receiver" channel -1 } ]
}
Robot {
  name "pilot_a_runner"
  controller "pilot_a_runner"
  supervisor TRUE
  children [
    Emitter { name "emitter" channel 1 }
    Emitter { name "story_emitter" channel 3 }
    Receiver { name "receiver" channel 2 }
  ]
}
